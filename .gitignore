__pycache__/
.cache/
results/**/cache/
results/**/matplotlib/
results/*smoke*/

# Python and test/build caches
*.py[cod]
.pytest_cache/

# 00B raw trajectories: regenerate with movement_lab.study00b.
# Keep small initial states, metadata, configs, and source snapshots.
/results/00b/**/trial.npz

# Incomplete CPU pilot and superseded/interrupted matrix trial artifacts.
/results/00b/pilot-99/
/results/00b/matrix/*/
/results/00b/matrix/comparison.html

# 00C raw trajectories remain local.
/results/00c/**/trial.npz
/results/00c/**/evaluation.log

# Archived 00C diagnostic/interrupted records stay local; publish notes/hashes.
/results/00c/excluded/*/
# Full comparison embeds every plot; retain only the report-linked PNG exports.
/results/00c/boundary/trajectory-dv*.png
!/results/00c/boundary/trajectory-dv-0.24.png
!/results/00c/boundary/trajectory-dv+0.18.png

# 01A compiled models include upstream meshes; preserve locally, do not publish.
/results/01a/**/replay_model.mjb
/results/01a/*.log
# Preflight and diagnostic attempts are retained locally and documented separately.
/results/01a/pilot/
/results/01a/pilot-gpu/
/results/01a/smoke/
/results/01a/smoke-state/
/results/01a/atlas/

# 01A full-rate raw trajectories remain local; retain initial states and hashes.
/results/01a/**/trial.npz

# 01B local full-rate trajectories, compiled geometry and evaluation logs.
/results/01b/**/trial.npz
/results/01b/**/replay_model.mjb
/results/01b*.log
# Bounded 01B landing diagnosis logs remain local and hashed.
/results/01b/landing-diagnosis/*.log
# Bounded 01B departure execution logs remain local and hashed.
/results/01b/departures/**/*.log

# 01B publication: retain redundant exports/preflight snapshots locally.
/results/01b/gate/
/results/01b/**/atlas.png
!/results/01b/gpu-gate/atlas.png
/results/01b/landing-diagnosis/preflight.txt
/results/01b/landing-diagnosis/preflight_inspect.py
/results/01b/departures/tests-initial.txt

# 01C full-rate trajectories, upstream geometry and runtime logs remain local.
/results/01c/**/trial.npz
/results/01c/**/replay_model.mjb
/results/01c/**/*.log

# 01C publication: failed zero-sample preflight and redundant per-trial plots.
/results/01c/pilot/
/results/01c/pilot-gpu/*/atlas.png
# Intermediate publication test run; final 38-test and original 36-test runs publish.
/results/01c/publication/tests-with-publication.txt
